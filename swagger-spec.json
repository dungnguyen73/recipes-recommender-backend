  "info": {
    "title": "Recipelens REST API",
    "description": "The NestJS API description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "updateRecipeDto": {
        "type": "object",
        "properties": {}
      },
      "ModifyFavoriteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "favorite": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "favorite"
        ]
      },
      "RateRecipeDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "recipeId": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          },
          "comment": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "recipeId",
          "rating",
          "comment",
          "timestamp"
        ]
      },
      "userPreferenceDto": {
        "type": "object",
        "properties": {}
      },
      "AddClickDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "recipeId": {
            "type": "number"
          }
        },
        "required": [
          "userId",
          "recipeId"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "SignInWithGoogleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "HybridRecommendationDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The unique identifier of the user (for personalized hybrid recommendation)",
            "example": "65f1a2b3c4d5e6f7a8b9c0d1"
          },
          "query": {
            "type": "string",
            "description": "The search query or recipe keywords",
            "example": "beef pasta tomato"
          },
          "k": {
            "type": "number",
            "description": "Number of recommendations to return",
            "example": 10,
            "default": 10
          }
        },
        "required": [
          "query"
        ]
      },
      "inferenceRequest": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "example": "base64 string",
            "description": "Base64 string of the image to be analyzed"
          }
        },
        "required": [
          "image"
        ]
      }
    }
  }
}